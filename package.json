{
  "name": "outboundly",
  "version": "0.1.0",
  "private": true,
  "description": "Outboundly desktop outreach application",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "npm run build:info && tsc -b && npm run copy:migrations && npm run build:renderer",
    "build:info": "node electron/generate-build-info.mjs",
    "copy:migrations": "node electron/copy-migrations.mjs",
    "build:renderer": "node electron/build-renderer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "electron:dev": "npm run build && npm run rebuild:native:electron && electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0",
    "node-html-parser": "^6.1.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.24.2",
    "electron": "^32.1.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
